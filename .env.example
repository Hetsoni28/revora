NEXT_PUBLIC_SANITY_PROJECT_ID=hi6d4ijd
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional. The dataset is public, so the site reads it without a token. Only set one (Viewer role)
# if the dataset is made private.
SANITY_API_TOKEN=

# Public address of the live site (used for canonical links, sitemap, robots and share images).
NEXT_PUBLIC_SITE_URL=https://revorahealthcare.com

# Enquiry emails (all forms). Leave empty until the domain is live: the forms then open the
# visitor's email app instead. Use the cPanel mailbox details. Never prefix these with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: sender address (defaults to SMTP_USER), and one address to receive every enquiry (testing).
MAIL_FROM=
ENQUIRY_TO=
